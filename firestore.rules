rules_version = '2';

// 식단 기록 그룹 공유 규칙
// - 그룹 정보와 그룹에 올린 식단·평가·댓글은 그 그룹 멤버만 볼 수 있음
// - 식단·평가는 본인 것만 올리고 지울 수 있음. 댓글은 멤버가 자기 이름으로만 남기고, 쓴 사람이나 기록 주인이 지울 수 있음
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // 내 닉네임 (나만)
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /groups/{gid} {
      function member() {
        return signedIn() && request.auth.uid in get(/databases/$(database)/documents/groups/$(gid)).data.members;
      }

      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn()
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.members == [request.auth.uid];
      allow update: if signedIn() && (
        // 멤버가 그룹 이름·멤버 이름·목표·프로필 사진·챌린지 수정
        (request.auth.uid in resource.data.members
          && request.resource.data.members == resource.data.members
          && changed().hasOnly(['name', 'names', 'goals', 'photos', 'challenge']))
        // 초대 코드로 참여: 자기 자신만 추가
        || (!(request.auth.uid in resource.data.members)
          && request.resource.data.members.toSet() == resource.data.members.toSet().union([request.auth.uid].toSet())
          && changed().hasOnly(['members', 'names', 'goals', 'photos']))
        // 나가기: 자기 자신만 빠짐 (방장이면 다른 멤버에게 넘김)
        || (request.auth.uid in resource.data.members
          && request.resource.data.members.toSet() == resource.data.members.toSet().difference([request.auth.uid].toSet())
          && changed().hasOnly(['members', 'names', 'goals', 'photos', 'owner']))
      );
      // 마지막 멤버가 나가면 그룹 삭제
      allow delete: if signedIn() && request.auth.uid in resource.data.members && resource.data.members.size() <= 1;

      match /{kind}/{docId} {
        allow read: if (kind == 'days' || kind == 'weeks') && member();
        allow create, update: if (kind == 'days' || kind == 'weeks') && member()
          && request.resource.data.uid == request.auth.uid
          && docId.matches(request.auth.uid + '_.*');
        allow delete: if (kind == 'days' || kind == 'weeks') && signedIn() && resource.data.uid == request.auth.uid;

        match /comments/{cid} {
          allow read: if member();
          allow create: if member()
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.text is string
            && request.resource.data.text.size() > 0
            && request.resource.data.text.size() <= 500;
          allow delete: if signedIn() && (resource.data.uid == request.auth.uid || docId.matches(request.auth.uid + '_.*'));
        }
      }
    }

    // 모두가 쓰는 음식: 직접 입력한 음식을 앱 사용자 모두가 검색에서 씀. 올린 사람만 고치거나 뺄 수 있음
    match /foods/{fid} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && fid.matches(request.auth.uid + '_.*')
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 80
        && request.resource.data.items is list
        && request.resource.data.items.size() <= 20
        && (resource == null || resource.data.uid == request.auth.uid);
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // 기기별 Gemini 키: 본인이 등록·삭제만 하고 아무도 읽을 수 없음 (사진 분석 서버만 관리자 권한으로 읽음)
    match /aiKeys/{uid} {
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.key is string
        && request.resource.data.key.size() < 300;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // 사진 분석 작업: 본인만 올리고 보고 지움. 결과는 서버만 적음 (앱은 분석을 다시 맡길 때만 덮어씀)
    match /photoJobs/{uid}/jobs/{jobId} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.status == 'queued'
        && request.resource.data.prompt is string
        && request.resource.data.models is list;
    }

    // 초대 코드 → 그룹. 코드를 아는 사람만 찾을 수 있음 (목록 조회 불가)
    match /codes/{code} {
      allow get: if signedIn();
      allow create: if signedIn()
        && getAfter(/databases/$(database)/documents/groups/$(request.resource.data.gid)).data.owner == request.auth.uid;
      allow delete: if signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/groups/$(resource.data.gid)).data.members;
    }
  }
}
