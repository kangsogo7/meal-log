<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/supp_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="14dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="@string/widget_supp" android:textColor="#5F6658" android:textSize="13sp" />
        <TextView android:id="@+id/supp_count" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#1B1F17" android:textSize="13sp" android:textStyle="bold" />
    </LinearLayout>
    <TextView android:id="@+id/supp_empty" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:text="@string/widget_supp_empty" android:textColor="#5F6658" android:textSize="11sp" />
    <TextView android:id="@+id/supp0" style="@style/WidgetSuppRow" />
    <TextView android:id="@+id/supp1" style="@style/WidgetSuppRow" />
    <TextView android:id="@+id/supp2" style="@style/WidgetSuppRow" />
    <TextView android:id="@+id/supp3" style="@style/WidgetSuppRow" />
</LinearLayout>
